{% extends 'base.html.twig' %}

{% block title %}
	{{ product.name }}
	• Green Goodies
{% endblock %}

{% block page_styles %}
	<link rel="stylesheet" href="{{ asset('css/product.css') }}">
{% endblock %}

{% block body %}
	<section class="product-view">
		<div class="product-media">
			<img src="{{ asset(product.image) }}" alt="{{ product.name }}" loading="eager">

		</div>

		<div class="product-details">
			<h1 class="product-title">{{ product.name }}</h1>
			<div class="product-price">{{ (product.price ?? 0)|number_format(2, ',', ' ') }}€</div>

			<h2 class="section-label">Description</h2>
			<div class="product-desc">
				{{ product.longDescription|default('')|nl2br }}
			</div>

			{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}


				<form method="post" action="{{ path('app_cart_add', { id: product.id }) }}">
					<div class="qty">
						<button type="button" class="qty-btn" data-qty-minus>-</button>
						<input type="number" name="quantity" value={{quantity ?? 0}} min="0" max="99" step="1" inputmode="numeric" pattern="\d*">
						<button type="button" class="qty-btn" data-qty-plus>+</button>
						{% if quantity !=   null %}
							<button class="btn-primary">Mettre à jour</button>

						{% else %}
							<button class="btn-primary">Ajouter au panier</button>


						{% endif %}


					</div>

				</form>

			{% endif %}


		</div>
	</section>
{% endblock %}
